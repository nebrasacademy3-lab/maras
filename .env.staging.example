# Local staging only. Copy to .env.staging and generate a distinct random hex secret for each required field.
# Never commit .env.staging. External providers are optional and use sandbox/test credentials only.
STAGING_ORIGIN=http://localhost:3000
STAGING_PORT=3000
POSTGRES_PASSWORD=
SESSION_SECRET=
ADMIN_API_TOKEN=
ADMIN_UPLOAD_TOKEN=
VIDEO_SIGNING_SECRET=
ADMIN_MFA_ENCRYPTION_KEY=
AI_KEYS_ENCRYPTION_KEY=
MALWARE_SCAN_TOKEN=
GEMINI_API_KEY=
TAP_SECRET_KEY=
TAP_WEBHOOK_SECRET=
RESEND_API_KEY=
EMAIL_FROM=

# Optional RevenueCat test project. compose.staging.yml enforces the sandbox environment.
REVENUECAT_SECRET_API_KEY=
REVENUECAT_PROJECT_ID=
REVENUECAT_APP_IDS=
REVENUECAT_WEBHOOK_SECRET=
