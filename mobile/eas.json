{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_STORE_MODE": "direct",
        "EXPO_PUBLIC_API_URL": "https://marasalelm.com",
        "EXPO_PUBLIC_EAS_PROJECT_ID": "684cf9e9-bf33-40bf-89a7-afba498cf90e"
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_STORE_MODE": "direct",
        "EXPO_PUBLIC_API_URL": "https://marasalelm.com",
        "EXPO_PUBLIC_EAS_PROJECT_ID": "684cf9e9-bf33-40bf-89a7-afba498cf90e"
      },
      "autoIncrement": true
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_STORE_MODE": "iap",
        "EXPO_PUBLIC_API_URL": "https://marasalelm.com",
        "EXPO_PUBLIC_EAS_PROJECT_ID": "684cf9e9-bf33-40bf-89a7-afba498cf90e"
      }
    },
    "production-direct": {
      "distribution": "internal",
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_STORE_MODE": "direct",
        "EXPO_PUBLIC_API_URL": "https://marasalelm.com",
        "EXPO_PUBLIC_EAS_PROJECT_ID": "684cf9e9-bf33-40bf-89a7-afba498cf90e"
      }
    },
    "staging-iap": {
      "distribution": "internal",
      "environment": "preview",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_STORE_MODE": "iap",
        "EXPO_PUBLIC_API_URL": "https://staging.example.invalid"
      }
    }
  },
  "submit": {
    "production": {
      "android": {
        "track": "internal"
      },
      "ios": {}
    }
  }
}
