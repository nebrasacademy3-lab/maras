# محليًا فقط؛ في بناء الإنتاج استخدم رابط خادم HTTPS الفعلي.
EXPO_PUBLIC_API_URL=http://localhost:3000
# reader هو الوضع المتوافق مع متاجر التطبيقات، وexternal يفتح موقع مراس في نسخ الاختبار الداخلية فقط.
EXPO_PUBLIC_STORE_MODE=reader
# مطلوب لتوليد Expo Push Token في نسخ Android وiOS المنشورة.
EXPO_PUBLIC_EAS_PROJECT_ID=
