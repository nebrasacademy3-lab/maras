# محليًا فقط؛ في بناء الإنتاج استخدم رابط خادم HTTPS الفعلي.
EXPO_PUBLIC_API_URL=https://marase.up.railway.app
# reader هو الوضع المتوافق مع متاجر التطبيقات، وdirect للنسخ الموزعة داخليًا التي تفتح الدفع عبر Tap.
# reader: App Store / Play build with no Tap purchase UI or checkout calls.
# direct: privately distributed build that can open Tap checkout.
EXPO_PUBLIC_STORE_MODE=reader
# مطلوب لتوليد Expo Push Token في نسخ Android وiOS المنشورة.
EXPO_PUBLIC_EAS_PROJECT_ID=
# نطاق روابط الويب التي يفتحها التطبيق مباشرة (Universal Links / App Links) مثل https://<host>/r/CODE.
# اتركه فارغًا ليُستخدم نطاق EXPO_PUBLIC_API_URL. يجب أن يقدّم الموقع ملفي
# /.well-known/apple-app-site-association و /.well-known/assetlinks.json لنفس النطاق.
EXPO_PUBLIC_APP_LINK_HOST=
