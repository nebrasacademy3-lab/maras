# قاعدة البيانات والنشر
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/meras
DATABASE_SSL=false
DATABASE_SSL_REJECT_UNAUTHORIZED=true
DATABASE_POOL_MAX=10
NEXT_PUBLIC_SITE_URL=http://localhost:3000
APP_URL=http://localhost:3000
MOBILE_APP_URL=
# نطاق نسخة Expo Web المنشورة عند تشغيلها على نطاق منفصل
EXPO_WEB_ORIGIN=
PORT=3000

# التخزين والتهيئة التلقائية
UPLOAD_DIR=./data/uploads
RUN_DB_MIGRATIONS=true
AUTO_SEED_CATALOG=true
# core هو الخيار السريع الموصى به. full ينشئ عشرات الآلاف من قوالب المواد.
CATALOG_SEED_MODE=core

# التخزين الخاص للفيديو (اختياري). عند غياب هذه القيم يستخدم النظام UPLOAD_DIR محليًا.
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true

# المعالجة المتكيفة: يبقى الفيديو الأصلي متاحًا حتى عند غياب FFmpeg.
VIDEO_WORKER_ENABLED=true
VIDEO_WORKER_POLL_MS=5000
VIDEO_WORKER_BATCH_SIZE=1
VIDEO_FFMPEG_PATH=ffmpeg
VIDEO_FFPROBE_PATH=ffprobe
VIDEO_FFMPEG_PRESET=medium
# صلاحية جلسة HLS بين 30 دقيقة و8 ساعات؛ الافتراضي 4 ساعات.
VIDEO_TOKEN_TTL_SECONDS=14400

# أسرار الخادم — استبدلها بقيم عشوائية مستقلة وطويلة في الإنتاج
SESSION_SECRET=replace-with-a-random-session-secret-of-at-least-32-characters
SESSION_COOKIE_SECURE=true
ADMIN_API_TOKEN=replace-with-a-random-secret-of-at-least-32-characters
ADMIN_UPLOAD_TOKEN=replace-with-another-random-secret-of-at-least-32-characters
VIDEO_SIGNING_SECRET=replace-with-a-third-random-secret-of-at-least-32-characters
# مفتاح مستقل لتشفير أسرار MFA (32 بايت على الأقل، ويفضل base64 عشوائيًا).
ADMIN_MFA_ENCRYPTION_KEY=replace-with-an-independent-random-mfa-key-of-at-least-32-bytes
# Dedicated credential for cron/scheduler calls. Never reuse ADMIN_API_TOKEN.
SCHEDULED_TASK_TOKEN=replace-with-a-fourth-independent-secret-of-at-least-32-characters
# ملح مستقل لتجزئة إشارات مكافحة إساءة استخدام الإحالات؛ لا يُرسل للعميل.
REFERRAL_HASH_SALT=replace-with-an-independent-random-referral-salt-of-at-least-32-characters
# اختر فقط الترويسة التي يعيد البروكسي الموثوق كتابتها؛ اتركها فارغة إذا لم يوجد بروكسي موثوق.
REFERRAL_TRUSTED_IP_HEADER=

# فحص المرفقات قبل إتاحتها للتحميل. يجب أن يعيد JSON يحوي clean=true أو status=clean.
MALWARE_SCAN_URL=
MALWARE_SCAN_TOKEN=

# الدفع عبر Tap (اختياري حتى تفعيل الدفع)
TAP_SECRET_KEY=
TAP_WEBHOOK_SECRET=

# مراس AI — يمكن وضع مفتاح منفرد أو عدة مفاتيح JSON/مفصولة بفواصل للتبديل التلقائي.
GEMINI_API_KEY=
GEMINI_API_KEYS=
AI_KEYS_ENCRYPTION_KEY=replace-with-an-independent-random-ai-key-of-at-least-32-bytes
AI_MONTHLY_PRICE_SAR=30
AI_MAX_STORED_FILES_PER_USER=30
AI_MAX_STORED_BYTES_PER_USER=209715200
AI_MAX_CONCURRENT_FILE_ACTIONS=4
AI_GEMINI_MAX_KEY_ATTEMPTS=3
AI_GEMINI_ATTEMPT_TIMEOUT_MS=35000
AI_GEMINI_OVERALL_TIMEOUT_MS=85000

# استعادة كلمة المرور عبر Resend (اختياري)
RESEND_API_KEY=
EMAIL_FROM=Meras Al-Elm <no-reply@example.com>

# المساعد الخارجي (اختياري؛ يبقى المحرك المحلي فعالًا بدونه)
OPENAI_API_KEY=
# يقبل عنوان الأساس /v1 أو مسار chat/completions كاملًا؛ عنوان الأساس أوضح.
OPENAI_API_URL=https://api.openai.com/v1
ASSISTANT_MODEL=gpt-5-mini
