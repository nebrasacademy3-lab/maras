# Public URLs
NEXT_PUBLIC_SITE_URL=https://your-railway-domain.up.railway.app
APP_URL=https://your-railway-domain.up.railway.app
# Optional Expo Web origin; keep empty for native-only apps.
MOBILE_APP_URL=
PORT=3000

# Railway PostgreSQL
DATABASE_URL=postgresql://postgres:password@host:5432/railway
# Set DATABASE_SSL=true only when your PostgreSQL provider requires TLS.
DATABASE_SSL=false
DATABASE_SSL_REJECT_UNAUTHORIZED=true
DATABASE_POOL_MAX=10
RUN_DB_MIGRATIONS=true

# Persistent file storage. On Railway, use the mounted Volume path.
UPLOAD_DIR=/data/uploads

# Tap Payments — keep secret keys server-side only
TAP_SECRET_KEY=
# Optional dedicated HMAC secret; if empty, TAP_SECRET_KEY is used.
TAP_WEBHOOK_SECRET=
TAP_PUBLIC_KEY=
TAP_MERCHANT_ID=

# Private video and administration
VIDEO_SIGNING_SECRET=replace-with-at-least-32-random-characters
ADMIN_API_TOKEN=replace-with-a-long-random-token
ADMIN_UPLOAD_TOKEN=replace-with-a-long-random-token

# Optional production providers
RESEND_API_KEY=
EMAIL_FROM=مراس العلم <no-reply@your-domain.example>
# Optional independent assistant provider; without these variables the local Arabic knowledge engine remains available.
OPENAI_API_KEY=
OPENAI_API_URL=https://api.openai.com/v1
ASSISTANT_MODEL=gpt-4o-mini
OTP_PROVIDER=
VIDEO_PROVIDER=filesystem
