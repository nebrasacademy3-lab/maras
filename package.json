{
  "name": "meras-alelm",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "start:railway": "bash scripts/start-railway.sh",
    "test": "npm run build && node --test tests/*.test.mjs",
    "lint": "eslint app components db lib scripts tests *.ts *.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "video:worker": "node --require ./scripts/tsx-runtime-bootstrap.cjs --import tsx scripts/video-worker.ts",
    "video:worker:once": "node --require ./scripts/tsx-runtime-bootstrap.cjs --import tsx scripts/video-worker.ts --once",
    "lifecycle:dispatch": "bash scripts/dispatch-lifecycle.sh",
    "files:scan": "node --require ./scripts/tsx-runtime-bootstrap.cjs --import tsx scripts/file-scan-worker.ts",
    "files:scan:once": "node --require ./scripts/tsx-runtime-bootstrap.cjs --import tsx scripts/file-scan-worker.ts --once",
    "qa:database": "node scripts/qa-database.mjs",
    "qa:seed": "node scripts/qa-seed.mjs",
    "qa:web": "node scripts/qa-web.mjs",
    "qa:store": "node --require ./scripts/tsx-runtime-bootstrap.cjs --import tsx scripts/qa-store-check.ts",
    "admin:bootstrap": "node --require ./scripts/tsx-runtime-bootstrap.cjs --import tsx scripts/bootstrap-admin.ts",
    "qa:build": "node scripts/qa-build.mjs",
    "release:package": "node scripts/package-release.mjs"
  },
  "dependencies": {
    "busboy": "1.6.0",
    "drizzle-orm": "0.45.2",
    "hls.js": "^1.6.13",
    "jose": "^6.1.0",
    "lucide-react": "^0.468.0",
    "next": "16.3.4",
    "pg": "^8.16.3",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@playwright/cli": "0.1.19",
    "@tailwindcss/postcss": "4.2.1",
    "@types/busboy": "1.5.4",
    "@types/node": "22.19.19",
    "@types/pg": "^8.15.5",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "drizzle-kit": "0.31.10",
    "embedded-postgres": "18.4.0-beta.17",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.4",
    "lighthouse": "13.4.1",
    "tailwindcss": "4.2.1",
    "tsx": "4.22.1",
    "typescript": "5.9.3"
  },
  "type": "module",
  "displayName": "مراس العلم",
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "0.25.12"
    }
  }
}
